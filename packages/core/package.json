{
  "name": "@easy-translate/core",
  "version": "0.1.0",
  "description": "Runtime-agnostic translation planning and execution core.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx tests/run.ts"
  },
  "keywords": [
    "translation",
    "typescript",
    "retry",
    "checkpoint"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
