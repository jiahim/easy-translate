{
  "name": "@easy-translate/core",
  "version": "0.2.0",
  "description": "Runtime-agnostic translation planning and execution core.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx tests/run.ts"
  },
  "keywords": [
    "translation",
    "typescript",
    "retry",
    "checkpoint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiahim/easy-translate.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/jiahim/easy-translate/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/jiahim/easy-translate/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
