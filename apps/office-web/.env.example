NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# 免费试用：硅基流动服务端配置。不要给私密变量添加 NEXT_PUBLIC_ 前缀。
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MAX_TOKENS=3072
# 仅限制等待模型响应头/首包，流式输出开始后不再计算；允许 10,000–110,000 毫秒。
SILICONFLOW_TIMEOUT_MS=30000
# 免费翻译默认关闭思考以缩短首包时间；设为 false 可显式重新开启。
SILICONFLOW_DISABLE_THINKING=true
SILICONFLOW_JSON_MODE=false

# 免费试用会话签名，生产环境至少使用 24 位随机字符串。
RATE_LIMIT_SECRET=

# 生产环境使用 Upstash Redis 持久化限流。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRIAL_REQUESTS_PER_MINUTE=20
TRIAL_DAILY_CHARACTERS=30000

# 可选但推荐：两者需同时配置。Site Key 可以公开，Secret Key 只能放在服务端。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
